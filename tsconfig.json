{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "types": ["jest"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": true
  },
  "include": ["src/**/*"],
  "exclude": ["tests", "node_modules"]
}